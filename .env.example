# Copy to .env and fill in real values. .env is git-ignored and must never be
# committed.

# --- Production (docker-compose.prod.yml) ---

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me

# External Postgres. The prod compose file has no database container of its own.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/food

# Public hostname Traefik serves the app on, over HTTPS.
PUBLIC_HOST=food.example.com

# Optional; default to PUBLIC_HOST / https://PUBLIC_HOST.
# ALLOWED_HOSTS=food.example.com
# CSRF_TRUSTED_ORIGINS=https://food.example.com

# Optional Traefik middleware chain; defaults to chain-public@file.
# Set empty to disable it.
# TRAEFIK_MIDDLEWARES=chain-public@file

# Optional contact in the User-Agent sent to Open Food Facts.
# OFF_CONTACT=you@example.com

# Optional background queue tuning. Delivery is at-least-once: recovery is
# age-based, so an interrupted or stuck task can run again and must be
# idempotent. The stuck threshold must exceed the longest task.
# TASKS_STUCK_AFTER_MINUTES=30
# TASKS_RESULT_RETENTION_DAYS=14
# Web Push VAPID-ключи живут в БД и меняются администратором в UI, не в .env.

# --- Development ---
#
# Dev settings need nothing here: docker-compose.yml provides its own Postgres
# and dev-only defaults. Running `manage.py test` without a database falls back
# to a local SQLite file.
